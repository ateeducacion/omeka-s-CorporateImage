{
    "name": "ateeducacion/omeka-s-corporateimage",
    "description": "Custom HTML for the public header and footer of Omeka S sites",
    "type": "omeka-s-module",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Área de Tecnología Educativa",
            "email": "ate.educacion@gobiernodecanarias.org"
        }
    ],
    "homepage": "https://github.com/ateeducacion/omeka-s-CorporateImage",
    "support": {
        "issues": "https://github.com/ateeducacion/omeka-s-CorporateImage/issues"
    },
    "keywords": [
        "Omeka S",
        "module",
        "header",
        "footer"
    ],
    "require": {
        "php": ">=7.4"
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "allow-plugins": {
            "omeka/composer-addon-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "squizlabs/php_codesniffer": "*",
        "phpunit/phpunit": "*",
        "zerocrates/extract-tagged-strings": "dev-master",
        "laminas/laminas-form": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "PersonalizedHeaderFooter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PersonalizedHeaderFooterTest\\": "test/PersonalizedHeaderFooterTest/"
        }
    },
    "repositories": [
        {
        "type": "vcs",
        "url": "https://github.com/zerocrates/extract-tagged-strings.git"
        }
    ]
}
